# Generated at deploy time by tools/prerender.mjs: one shell per post, with a
# baked <head> so each entry has its own indexable URL. Content still comes
# from PocketBase at runtime — these are shells, not content — but they are
# derived files and do not belong in git.
/blog/*/
/projects/*/
sitemap.xml
robots.txt
